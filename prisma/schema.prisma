// Prisma schema: sistema de organización, planificación y registro de trabajo

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Prioridad {
  URGENTE
  ALTA
  MEDIA
  BAJA
}

enum Frecuencia {
  SEMANAL
  MENSUAL
}

model Tema {
  id               Int    @id @default(autoincrement())
  colorPrincipal   String @default("#3b82f6")
  /** Horas seguidas de un timer corriendo antes de avisar que puede haber
   * quedado olvidado. */
  avisoTimerHoras  Float  @default(4)
  /// Día en que arranca la semana en la grilla de Registro (0=domingo..6=sábado, convención date-fns weekStartsOn). Por defecto 1 (lunes).
  inicioSemana     Int    @default(1)
  /// Hora (0-23) en la que arranca por defecto la grilla de Registro — se expande igual hacia atrás si hay un registro más temprano.
  horaInicioGrilla Int    @default(8)
}

model Estado {
  id               Int     @id @default(autoincrement())
  nombre           String
  orden            Int     @default(0)
  color            String
  mostrarEnBacklog Boolean @default(true)
  /// Estado fijo de arranque del flujo: siempre el de menor orden, no se puede eliminar ni reordenar.
  esInicial        Boolean @default(false)
  /// Estado fijo de cierre del flujo: siempre el de mayor orden, no se puede eliminar ni reordenar.
  esFinal          Boolean @default(false)
  tareas           Tarea[]
}

model TipoTrabajo {
  id        Int              @id @default(autoincrement())
  nombre    String
  orden     Int              @default(0)
  activo    Boolean          @default(true)
  registros RegistroTiempo[]
  timers    TimerActivo[]
}

model Cliente {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  color          String
  activo         Boolean  @default(true)
  predeterminado Boolean  @default(false)
  createdAt      DateTime @default(now())
  /// Tareas raíz (parentId null) de este cliente — lo que antes era Proyecto.
  tareas         Tarea[]
}

/// Modelo unificado: una Tarea sin parentId es lo que antes era un Proyecto
/// ("raíz"); con parentId es una subtarea, a cualquier profundidad.
model Tarea {
  id             Int                   @id @default(autoincrement())
  parentId       Int?
  parent         Tarea?                @relation("TareaJerarquia", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  hijos          Tarea[]               @relation("TareaJerarquia")

  /// Solo tiene sentido en la raíz (parentId null); los hijos resuelven
  /// cliente/color subiendo hasta su ancestro raíz.
  clienteId      Int?
  cliente        Cliente?              @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  color          String?

  nombre         String
  descripcion    String?
  /// Archivado. Antes solo existía en Proyecto; ahora aplica a cualquier nivel.
  activo         Boolean               @default(true)
  prioridad      Prioridad             @default(MEDIA)
  /// Toda tarea, raíz o no, siempre tiene un estado real (regla fija del flujo).
  estadoId       Int
  estado         Estado                @relation(fields: [estadoId], references: [id])
  horasEstimadas Float?
  imprevista     Boolean               @default(false)
  /// Orden entre hermanos: por parentId, o por clienteId si es raíz.
  orden          Int                   @default(0)
  /// Orden dentro de una columna de Kanban / grupo por estado (por estadoId).
  ordenEstado    Int                   @default(0)
  createdAt      DateTime              @default(now())

  /// Si está tildado, al cerrarse (llegar a un estado esFinal) se crea
  /// automáticamente la siguiente instancia con el período recalculado.
  recurrente             Boolean     @default(false)
  recurrenciaFrecuencia  Frecuencia?
  /// Cada cuántas semanas/meses (según recurrenciaFrecuencia) se repite. Default 1.
  recurrenciaIntervalo   Int?
  /// Nombre sin el período ("Reunión de seguimiento"), usado para armar el
  /// `nombre` de cada instancia nueva ("Reunión de seguimiento — Semana del ...").
  nombreBase             String?
  /// Apunta a la primera tarea de la cadena de instancias recurrentes — para
  /// poder reconstruir el historial completo de una serie. No se usa aún en
  /// ninguna pantalla.
  serieId                Int?
  serie                  Tarea?      @relation("TareaSerie", fields: [serieId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  instanciasDeLaSerie    Tarea[]     @relation("TareaSerie")

  registros      RegistroTiempo[]
  planificacion  PlanificacionSemana[]
  timers         TimerActivo[]
}

model RegistroTiempo {
  id            Int         @id @default(autoincrement())
  fecha         DateTime
  tareaId       Int
  tarea         Tarea       @relation(fields: [tareaId], references: [id])
  tipoTrabajoId Int
  tipoTrabajo   TipoTrabajo @relation(fields: [tipoTrabajoId], references: [id])
  horaInicio    String
  horaFin       String
  comentarios   String?
  createdAt     DateTime    @default(now())
}

/// Timer en curso. Solo puede existir una fila a la vez (app de un solo usuario);
/// al detenerlo se convierte en un RegistroTiempo y se borra.
model TimerActivo {
  id            Int         @id @default(autoincrement())
  tareaId       Int
  tarea         Tarea       @relation(fields: [tareaId], references: [id])
  tipoTrabajoId Int
  tipoTrabajo   TipoTrabajo @relation(fields: [tipoTrabajoId], references: [id])
  inicio        DateTime    @default(now())
  comentarios   String?
}

model PlanificacionSemana {
  id                Int      @id @default(autoincrement())
  tareaId           Int
  tarea             Tarea    @relation(fields: [tareaId], references: [id])
  fecha             DateTime
  horasPlanificadas Float?
  createdAt         DateTime @default(now())
}

/// Calendario externo (Google/Outlook/etc.) suscripto por URL de feed iCal —
/// de solo lectura, se muestra superpuesto en la grilla de Registro. Se
/// puede conectar más de uno.
model CalendarioExterno {
  id        Int      @id @default(autoincrement())
  nombre    String
  urlIcs    String
  color     String   @default("#64748b")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}
